# ===== worker: copie para .env e preencha (ou use um .env na pasta de cima) =====

# Onde ficam os vídeos enviados:
#   site = no disco do próprio site (index.js com ARMAZENAMENTO=site), sem R2
#   r2   = Cloudflare R2
ARMAZENAMENTO=site

# --- ARMAZENAMENTO=site ---
# O WORKER_TOKEN tem que ser IGUAL ao do .env do index.js (gere com 40+ caracteres aleatórios).
WORKER_TOKEN=
# Endereço da API do bot-mmr (o mesmo de API_URL_PUBLICA):
SITE_URL=https://seu-subdominio.discloud.dev

# --- ARMAZENAMENTO=r2 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=dbd-mmr

# Banco Postgres. Na Discloud: a URL do banco que você criou lá (o host interno só funciona dentro da Discloud).
# No Supabase: use a do "Session pooler" (host *.pooler.supabase.com).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO

# Canal do Discord que recebe as análises
DISCORD_WEBHOOK_URL=

# Opcional: token do bot (o mesmo do index.js). Confere se o ID do jogador existe e pega nome/avatar.
DISCORD_TOKEN=

# ===== Ajustes (todos opcionais) =====
# PROCESSOS=3               # núcleos usados na análise (padrão: núcleos - 1, máx. 8)
# FPS_AMOSTRA=2             # frames analisados por segundo de vídeo
# CONFIANCA_MINIMA=0.30     # abaixo disso o vídeo é recusado (HUD não reconhecida)
# DURACAO_MINIMA=240        # partidas mais curtas contam como "incompletas" (MMR vale metade)
# MAX_PARTIDAS_24H=15       # limite por jogador
# K_FACTOR=40
# DELTA_MAX=50              # maior ganho/perda de MMR por partida
# APAGAR_VIDEO=1            # 0 = guarda o vídeo processado em falhas/ em vez de apagar
# MENCIONAR_JOGADOR=1       # marca o jogador no embed
# EXIGIR_ID_DISCORD=0       # 1 = só aceita ID do Discord (o site manda o uid do Firebase, então deixe 0)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# NOME_SERVIDOR=Refúgio da Névoa
# --- Destaques (clipes da partida no Discord) ---
# HIGHLIGHTS=1              # 0 = não manda clipes, só o relatório
# HIGHLIGHTS_MAX=3          # quantos clipes por partida
# HIGHLIGHT_MAX_MB=9.5      # tamanho máximo de cada clipe (Discord aceita 10 MB por arquivo em servidor sem boost)
# HIGHLIGHT_ALTURA=720      # resolução dos clipes (720 ou 540)
# HIGHLIGHT_SEG_MAX=40      # duração máxima de cada clipe, em segundos
