# ===== bot-mmr: copie para .env e preencha =====

# Segredo compartilhado com o worker (o MESMO valor no .env do worker, 40+ caracteres aleatórios)
WORKER_TOKEN=

# Token do bot do Discord
DISCORD_TOKEN=

# projectId do seu Firebase (o mesmo do site)
FIREBASE_PROJECT_ID=

# Endereço público desta API (os links de envio são montados com ele)
API_URL_PUBLICA=https://seu-subdominio.discloud.dev

# Sites que podem chamar a API, separados por vírgula
ALLOWED_ORIGINS=https://seusite.com.br,https://www.seusite.com.br

# ===== Opcionais =====
# ARMAZENAMENTO=site          # site = disco do app · r2 = Cloudflare R2
# PASTA_VIDEOS=./videos
# MAX_TAMANHO_GB=5
# LINKS_POR_HORA=6
# GUARDAR_FALHAS_DIAS=3

# ===== Só com ARMAZENAMENTO=r2 =====
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
